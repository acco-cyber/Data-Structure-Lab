#include <stdio.h>

int binarySearch(int DATA[], int LB, int UB, int ITEM) {
    int BEG = LB;
    int END = UB;
    int MID;

    while (BEG <= END) {
        MID = (BEG + END) / 2;

        if (DATA[MID] == ITEM)
            return MID;

        if (ITEM < DATA[MID])
            END = MID - 1;
        else
            BEG = MID + 1;
    }

    return -1;
}

int main() {
    int n, ITEM;

    printf("Enter number of elements: ");
    scanf("%d", &n);

    int DATA[n];

    printf("Enter sorted elements:\n");
    for(int i = 0; i < n; i++) {
        scanf("%d", &DATA[i]);
    }

    printf("Enter item to search: ");
    scanf("%d", &ITEM);

    int result = binarySearch(DATA, 0, n - 1, ITEM);

    if (result != -1)
        printf("Item found at index: %d\n", result);
    else
        printf("Item not found\n");

    return 0;
}
